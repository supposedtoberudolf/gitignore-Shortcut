1. mkdir -p ~/bin

2. cat > ~/bin/gitignore <<'EOF'
#!/bin/bash

printf "*.exe\ntempCodeRunnerFile.c\n*.out\n*.o\n" > .gitignore

echo ".gitignore created successfully!"
EOF

3. chmod +x ~/bin/gitignore

4. echo 'export PATH="$HOME/bin:$PATH"' >> ~/.bashrc

5. source ~/.bashrc

6. Go to your Project Folder

7. run gitignore